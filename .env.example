# Environment variables for cdenn-port-v2.
# Copy to `.env.local` and fill in real values. Never commit a filled-in file.
#
# Every variable below is read somewhere in the code. The three contact
# variables are server-only: they must not be prefixed with NEXT_PUBLIC_,
# or the API key would be inlined into the client bundle.

# Resend API key, used to send contact / privacy-request / CV-request emails.
# Read in: src/app/lib/email.ts (getResendClient)
# Without it, all three form routes answer 503 instead of crashing.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_000000000000000000000000

# Destination inbox that form submissions are delivered to.
# Read in: src/app/lib/email.ts (getContactEmail)
# Required: a missing value also makes the form routes answer 503.
CONTACT_EMAIL=you@example.com

# Sender address for outgoing transactional mail. Optional.
# Read in: src/app/lib/email.ts (resolveFromEmail)
# If unset, the code falls back to Resend's shared test sender
# (onboarding@resend.dev), which is rate-limited and only reliably
# delivers to the Resend account owner. Set a verified-domain sender
# before relying on this in production.
CONTACT_FROM_EMAIL=CDenn <contact@example.com>

# Public booking link shown on the contact section. Optional.
# Read in: src/app/components/sections/ContactSection.tsx
# NEXT_PUBLIC_ means this value is embedded in the client bundle, so it
# must be a public URL only. If unset, the booking affordance is hidden.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro
